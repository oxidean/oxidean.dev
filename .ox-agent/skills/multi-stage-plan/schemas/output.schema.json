{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "invocation_id",
    "skill",
    "status",
    "verdict",
    "summary",
    "artifacts",
    "findings",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "invocation_id": {
      "type": "string"
    },
    "skill": {
      "const": "ox-agent/multi-stage-plan"
    },
    "status": {
      "enum": [
        "complete",
        "blocked",
        "failed"
      ]
    },
    "verdict": {
      "enum": [
        "pass",
        "pass_with_notes",
        "needs_rework",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "artifacts": {
      "type": "array"
    },
    "findings": {
      "type": "array"
    },
    "next_action": {
      "type": "object"
    }
  }
}
