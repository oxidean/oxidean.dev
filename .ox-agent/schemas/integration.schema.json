{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ox-agent.dev/schemas/integration.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "adapter"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "string",
      "enum": [
        "manual",
        "spawn-cli",
        "api"
      ]
    },
    "command": {
      "type": "string"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "default": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
