---
import SiteShell from "@/layouts/SiteShell.astro";
import { CopyCommand } from "@/components/copy-command";
import { TerminalDemo } from "@/components/terminal-demo";

const features = [
	{
		title: "Git hosting, batteries in",
		body: "Repositories over SSH or HTTPS with LFS, releases, and mirrors — clone, push, tag, done.",
		icon: '<line x1="6" x2="6" y1="3" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>',
	},
	{
		title: "Pull requests & review",
		body: "Diffs, inline comments, and merge controls in a workflow you already know — no retraining your team.",
		icon: '<circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><line x1="6" x2="6" y1="9" y2="21"/>',
	},
	{
		title: "Issues & organizations",
		body: "Labels, assignees, and org-scoped teams keep triage next to the code it tracks.",
		icon: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="1"/>',
	},
	{
		title: "CI actions on your runners",
		body: "Pipelines execute on infrastructure you own — job logs, artifacts, and caches stay inside the forge.",
		icon: '<rect width="8" height="8" x="3" y="3" rx="2"/><path d="M7 11v4a2 2 0 0 0 2 2h4"/><rect width="8" height="8" x="13" y="13" rx="2"/>',
	},
	{
		title: "Package registries",
		body: "npm, OCI container images, and generic artifacts served from the same origin as your git.",
		icon: '<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
	},
	{
		title: "One product, two faces",
		body: "Oxidean Cloud and self-host ship the same images — no feature fork, no second-class install.",
		icon: '<rect width="20" height="8" x="2" y="2" rx="2"/><rect width="20" height="8" x="2" y="14" rx="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/>',
	},
];
---

<SiteShell
	title="Oxidean — a code forge that answers to you"
	description="Self-hostable code forge — git hosting, pull requests, issues, CI actions, and package registries in one product. The same codebase runs Oxidean Cloud and installs on your machines."
>
	<section class="relative overflow-hidden">
		<div aria-hidden="true" class="hero-grid absolute inset-0"></div>
		<div aria-hidden="true" class="hero-glow absolute inset-0"></div>
		<div class="relative mx-auto grid w-full max-w-6xl items-center gap-12 px-5 pb-20 pt-16 sm:px-6 sm:pt-24 lg:grid-cols-[1.05fr_0.95fr] lg:pb-28">
			<div>
				<p class="oct-rise font-mono text-[11px] font-medium uppercase tracking-[0.22em] text-primary">
					Self-hostable forge · MIT licensed
				</p>
				<h1
					class="oct-rise mt-4 font-display text-[2.6rem] font-bold leading-[1.05] tracking-tight sm:text-6xl"
					style="animation-delay: 60ms"
				>
					A code forge that <span class="text-primary">answers to you</span>.
				</h1>
				<p
					class="oct-rise mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground"
					style="animation-delay: 120ms"
				>
					Git hosting, pull requests, issues, CI actions, and package registries
					in one product. The same codebase runs Oxidean Cloud and installs on
					your machines.
				</p>
				<div
					class="oct-rise mt-8 flex flex-wrap items-center gap-3"
					style="animation-delay: 180ms"
				>
					<a
						href="/docs/quickstart/"
						class="inline-flex h-11 items-center gap-2 rounded-md bg-primary px-5 font-display text-[15px] font-semibold text-primary-foreground transition hover:brightness-110"
					>
						Get started
						<svg
							viewBox="0 0 24 24"
							width="16"
							height="16"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M5 12h14" />
							<path d="m12 5 7 7-7 7" />
						</svg>
					</a>
					<a
						href="https://github.com/oxidean/oxidean"
						target="_blank"
						rel="noopener"
						class="inline-flex h-11 items-center gap-2 rounded-md border border-border bg-card px-5 font-display text-[15px] font-semibold text-foreground transition hover:border-foreground/30 hover:bg-muted"
					>
						<svg
							viewBox="0 0 16 16"
							width="16"
							height="16"
							aria-hidden="true"
							class="fill-current"
						>
							<path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path>
						</svg>
						oxidean/oxidean
					</a>
				</div>
				<div class="oct-rise mt-6" style="animation-delay: 240ms">
					<CopyCommand
						client:load
						command="docker compose up -d"
						className="max-w-fit"
					/>
					<p class="mt-2 font-mono text-[12px] text-muted-foreground">
						One compose file. Published images. No build step.
					</p>
				</div>
			</div>
			<div class="oct-rise lg:pl-4" style="animation-delay: 200ms">
				<TerminalDemo client:load />
			</div>
		</div>
	</section>

	<section class="border-t border-border">
		<div class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-6 sm:py-20">
			<p class="oct-reveal font-mono text-[11px] font-medium uppercase tracking-[0.22em] text-primary">
				Capabilities
			</p>
			<h2 class="oct-reveal mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
				Everything a forge should be.
			</h2>
			<p class="oct-reveal mt-3 max-w-2xl text-muted-foreground">
				Not a git server with plugins bolted on — the whole workflow, designed
				as one product and shipped as one codebase.
			</p>
			<div class="oct-reveal mt-10 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
				{features.map((f) => (
					<div class="bg-background p-6 transition-colors hover:bg-card">
						<span class="inline-flex size-9 items-center justify-center rounded-md border border-border bg-card text-primary">
							<svg
								viewBox="0 0 24 24"
								width="18"
								height="18"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								set:html={f.icon}
							/>
						</span>
						<h3 class="mt-4 font-display text-[17px] font-semibold">
							{f.title}
						</h3>
						<p class="mt-1.5 text-[14px] leading-relaxed text-muted-foreground">
							{f.body}
						</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="border-t border-border bg-card/40">
		<div class="mx-auto grid w-full max-w-6xl items-center gap-10 px-5 py-16 sm:px-6 sm:py-20 lg:grid-cols-2">
			<div>
				<p class="oct-reveal font-mono text-[11px] font-medium uppercase tracking-[0.22em] text-primary">
					Self-host
				</p>
				<h2 class="oct-reveal mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
					One compose file. One volume. Yours.
				</h2>
				<p class="oct-reveal mt-3 max-w-xl text-muted-foreground">
					Every forge artifact — repos, LFS objects, packages, action logs —
					lives in a single named volume behind one HTTP origin. Swap the
					bundled Postgres for MySQL or SQLite, add the TLS or Actions profile,
					or take the same stack to Kubernetes with the Helm chart.
				</p>
				<div class="oct-reveal mt-6 flex flex-wrap gap-3">
					<a
						href="/docs/self-hosting/"
						class="inline-flex h-10 items-center rounded-md border border-border bg-card px-4 font-display text-[14px] font-semibold transition hover:border-foreground/30 hover:bg-muted"
					>
						Self-hosting docs
					</a>
					<a
						href="https://github.com/oxidean/oxidean/tree/main/deploy/selfhost"
						target="_blank"
						rel="noopener"
						class="inline-flex h-10 items-center rounded-md px-2 font-display text-[14px] font-semibold text-primary transition hover:underline"
					>
						deploy/selfhost →
					</a>
				</div>
			</div>
			<div class="oct-reveal space-y-3">
				<div class="overflow-hidden rounded-lg border border-border bg-card">
					<div class="border-b border-border px-4 py-2 font-mono text-[11px] uppercase tracking-[0.15em] text-muted-foreground">
						Docker Compose
					</div>
					<pre class="overflow-x-auto p-4 font-mono text-[13px] leading-6"><code><span class="text-muted-foreground"># published images — no toolchain, no build step</span>
<span class="text-foreground">docker compose up -d</span>
<span class="text-muted-foreground"># optional profiles: tls, actions, s3</span></code></pre>
				</div>
				<div class="overflow-hidden rounded-lg border border-border bg-card">
					<div class="border-b border-border px-4 py-2 font-mono text-[11px] uppercase tracking-[0.15em] text-muted-foreground">
						Kubernetes
					</div>
					<pre class="overflow-x-auto p-4 font-mono text-[13px] leading-6"><code><span class="text-foreground">helm install oxidean \</span>
<span class="text-foreground">  oci://ghcr.io/oxidean/charts/oxidean</span></code></pre>
				</div>
			</div>
		</div>
	</section>

	<section class="border-t border-border">
		<div class="mx-auto w-full max-w-6xl px-5 py-14 text-center sm:px-6">
			<p class="oct-reveal font-mono text-[12px] text-muted-foreground">
				This site is Astro + Octane islands — the same UI stack that ships in
				the forge.
				<a
					href="https://github.com/oxidean/oxidean.dev"
					target="_blank"
					rel="noopener"
					class="text-primary hover:underline"
				>
					Source
				</a>
			</p>
		</div>
	</section>
</SiteShell>

<script>
	function bootReveals() {
		const els = document.querySelectorAll<HTMLElement>(".oct-reveal");
		if (!("IntersectionObserver" in window)) {
			els.forEach((el) => el.classList.add("oct-reveal-in"));
			return;
		}
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (e.isIntersecting) {
						e.target.classList.add("oct-reveal-in");
						io.unobserve(e.target);
					}
				}
			},
			{ threshold: 0.12 },
		);
		els.forEach((el) => io.observe(el));
	}
	bootReveals();
	document.addEventListener("astro:page-load", bootReveals);
</script>
